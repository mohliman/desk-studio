{
  "name": "desk-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:server && node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc -b && vite build && npm run build:server",
    "test": "vitest run src",
    "verify": "npm run test:fullstack",
    "test:a11y": "npm run test:fullstack",
    "format": "prettier --write src scripts *.json *.ts *.md index.html",
    "test:design": "npm run test:fullstack",
    "dev:ui": "vite --host 127.0.0.1 --port 5174",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env server/dist/index.mjs",
    "test:server": "npm run build:server && node --test server/*.test.mjs",
    "test:fullstack": "npm run build && node scripts/fullstack-verify.mjs",
    "test:e2e": "npm run test:fullstack"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.13",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
